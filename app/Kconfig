# SPDX-License-Identifier: Apache-2.0

menu "Sensor node application"

config APP_DEVICE_ID
	string "Device identifier used as MQTT client ID and in the topic"
	default "sensor-node-01"

config APP_MQTT_BROKER_HOST
	string "MQTT broker host name (must match the broker certificate)"
	default "mosquitto"
	help
	  Resolved with getaddrinfo(). The same name is used for TLS server
	  name verification, so it must be a subjectAltName of the broker
	  certificate generated by `make certs`.

config APP_MQTT_BROKER_ADDR
	string "Fixed broker IPv4 address (empty = resolve APP_MQTT_BROKER_HOST)"
	default ""
	help
	  For setups without DNS, e.g. the real board cabled directly to the
	  laptop. The TLS server name check still uses APP_MQTT_BROKER_HOST.

config APP_MQTT_BROKER_PORT
	int "MQTT broker TLS port"
	default 8883

config APP_PUBLISH_INTERVAL_MS
	int "Interval between sensor readings in milliseconds"
	default 1000

config APP_PUBLISH_COUNT
	int "Number of readings to publish before disconnecting (0 = forever)"
	default 0

endmenu

source "Kconfig.zephyr"
