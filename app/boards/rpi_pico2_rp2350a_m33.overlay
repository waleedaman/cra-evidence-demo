/* SPDX-License-Identifier: Apache-2.0 */
/* Raspberry Pi Pico 2 (or pin-compatible clone) + WIZnet W5500 Ethernet module.
 * Wiring copies the WIZnet W5500-EVB-Pico2 board exactly, so both builds behave
 * the same:
 *   GP16 MISO, GP17 CS, GP18 SCK, GP19 MOSI, GP20 RESET, GP21 INT, 3V3, GND
 */
&spi0 {
	status = "okay";
	cs-gpios = <&gpio0 17 GPIO_ACTIVE_LOW>;

	ethernet: w5500@0 {
		compatible = "wiznet,w5500";
		reg = <0x0>;
		spi-max-frequency = <50000000>;
		int-gpios = <&gpio0 21 GPIO_ACTIVE_LOW>;
		reset-gpios = <&gpio0 20 GPIO_ACTIVE_LOW>;
		local-mac-address = [02 00 00 77 00 02];
		status = "okay";
	};
};
