# Single source of truth for every pinned version and checksum.
# Read by the Makefile (include), by docker/install-tools.sh (source) and by
# pipeline/doctor.py + pipeline/lockdoc.py. Keep it KEY=VALUE, no quotes, no spaces.
# versions.lock.md is generated from this file: run `make lock-doc` after editing.

# --- Zephyr --------------------------------------------------------------
ZEPHYR_VERSION=v4.4.2
# commit the annotated tag v4.4.2 points to (git ls-remote 'refs/tags/v4.4.2^{}')
ZEPHYR_COMMIT=dccb09599635bdff17633fa7e9dab014b91dce90
# module revisions as pinned by zephyr v4.4.2 west.yml (imported via name-allowlist)
MODULE_MBEDTLS_SHA=a3e190fe44c78d1ba67f55979e1257328cc7d0d8
MODULE_CMSIS_6_SHA=30a859f44ef8ab4dc8f84b03ed586fd16ccf9d74
MODULE_PICOLIBC_SHA=01254932e8e81085817ed61fd858648584ffe37c

# --- Base image ------------------------------------------------------------
# Official Zephyr CI base image (no SDK). Digest is recorded by `make pin-base`.
CI_BASE_IMAGE=ghcr.io/zephyrproject-rtos/ci-base
CI_BASE_TAG=v0.29.4
CI_BASE_DIGEST=sha256:0a4e08683a5582748696dd28d1633566be04218174811eb532e170a13e14959b
CI_BASE_DIGEST_RECORDED=2026-10-15

# --- Zephyr SDK (minimal bundle + ARM GNU toolchain only) --------------------
# sha256 from sdk-ng v1.0.1 sha256.sum, cross-checked with the GitHub release asset digest
ZEPHYR_SDK_VERSION=1.0.1
ZEPHYR_SDK_MINIMAL_SHA256=ca9bc0ff66fafca1dac9d592a36d953cf16d096a9d09b1c0357f021cf9f6a7eb
ZEPHYR_SDK_ARM_SHA256=21b85981cb5a1818d9bc53d82af80f208946ec038b982ff1907287572ed3a634

# --- CLI tools (linux/amd64 release artifacts) -------------------------------
# sha256 from each project's published checksum file, cross-checked with the
# GitHub release asset digest
GRYPE_VERSION=0.120.1
GRYPE_SHA256=0a9ee97ef5ae2ee953b0a80098105052e846cdbe319a57d808b519c33cd1343d
OSV_SCANNER_VERSION=2.7.0
OSV_SCANNER_SHA256=160c6253e2922e9e0a6a9771c5c4c40a4b3c6090b34a3cdd5e80c96cc2e4218b
VEXCTL_VERSION=0.4.4
VEXCTL_SHA256=d315e2778af88b999ad4bba30a08aa2677ed701638e16c341b6d57b43c1e064d
COSIGN_VERSION=3.1.3
COSIGN_SHA256=4629c757b7618056f8ddd7e2625ae9fdd94c0372a65049520bc7d9df9efc7f71
JQ_VERSION=1.8.2
JQ_SHA256=b1c22172dd303f3be49e935aa56aa48a8b7a46e0bc838b4997d3bb451495870f

# Python packages are pinned with hashes in requirements.lock (from requirements.in).
